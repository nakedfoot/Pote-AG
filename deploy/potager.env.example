# Copié vers /etc/potager.env par install.sh (jamais écrasé lors d'une mise à jour).
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATA_DIR=/var/lib/potager
TZ=Europe/Paris
# Mettre à true si l'appli est servie en HTTPS (reverse proxy) : cookie de session « secure ».
COOKIE_SECURE=false
# Clé de chiffrement des mots de passe MQTT / secret OpenPlantbook.
# Laisser vide : une clé est générée dans $DATA_DIR/.secret au premier lancement.
# APP_SECRET=
